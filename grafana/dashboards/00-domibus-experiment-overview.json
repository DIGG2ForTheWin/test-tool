{
  "apiVersion": "dashboard.grafana.app/v2",
  "kind": "Dashboard",
  "metadata": {
    "name": "domibus-experiment-overview"
  },
  "spec": {
    "annotations": [
      {
        "kind": "AnnotationQuery",
        "spec": {
          "builtIn": true,
          "enable": true,
          "hide": true,
          "iconColor": "rgba(0, 211, 255, 1)",
          "name": "Annotations & Alerts",
          "query": {
            "datasource": {
              "name": "-- Grafana --"
            },
            "group": "grafana",
            "kind": "DataQuery",
            "spec": {},
            "version": "v0"
          }
        }
      }
    ],
    "cursorSync": "Off",
    "description": "Project landing dashboard for Domibus performance experiments. Run-level panels require the domibus_poc_* experiment metrics contract.",
    "editable": true,
    "elements": {
      "panel-current-phase": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "Current Phase",
          "description": "Current experimental phase reported by the project metrics source.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "Prometheus"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "domibus_poc_project_info",
                        "instant": true,
                        "legendFormat": "{{current_phase}}",
                        "range": false
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "13.2.0",
            "spec": {
              "options": {
                "reduceOptions": {
                  "values": false,
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": ""
                },
                "orientation": "auto",
                "textMode": "name",
                "wideLayout": true,
                "colorMode": "value",
                "graphMode": "none",
                "justifyMode": "auto",
                "showPercentChange": false,
                "percentChangeColorMode": "standard"
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "color": {
                    "mode": "thresholds"
                  },
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "color": "green",
                        "value": 0
                      }
                    ]
                  },
                  "noValue": "—"
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-total-runs": {
        "kind": "Panel",
        "spec": {
          "id": 2,
          "title": "Total Runs",
          "description": "Total number of Run records exposed to Prometheus.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "Prometheus"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "count(domibus_poc_run_info)",
                        "instant": true,
                        "legendFormat": "__auto",
                        "range": false
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "13.2.0",
            "spec": {
              "options": {
                "reduceOptions": {
                  "values": false,
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": ""
                },
                "orientation": "auto",
                "textMode": "auto",
                "wideLayout": true,
                "colorMode": "value",
                "graphMode": "none",
                "justifyMode": "auto",
                "showPercentChange": false,
                "percentChangeColorMode": "standard"
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "none",
                  "color": {
                    "mode": "thresholds"
                  },
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "color": "green",
                        "value": 0
                      }
                    ]
                  },
                  "noValue": "—"
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-valid-pass": {
        "kind": "Panel",
        "spec": {
          "id": 3,
          "title": "VALID_PASS",
          "description": "Runs whose canonical result is VALID_PASS.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "Prometheus"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "count(domibus_poc_run_info{run_result=\"VALID_PASS\"})",
                        "instant": true,
                        "legendFormat": "__auto",
                        "range": false
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "13.2.0",
            "spec": {
              "options": {
                "reduceOptions": {
                  "values": false,
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": ""
                },
                "orientation": "auto",
                "textMode": "auto",
                "wideLayout": true,
                "colorMode": "value",
                "graphMode": "none",
                "justifyMode": "auto",
                "showPercentChange": false,
                "percentChangeColorMode": "standard"
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "none",
                  "color": {
                    "mode": "thresholds"
                  },
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "color": "green",
                        "value": 0
                      }
                    ]
                  },
                  "noValue": "—"
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-non-passing": {
        "kind": "Panel",
        "spec": {
          "id": 4,
          "title": "Non-passing Runs",
          "description": "Runs whose canonical result is not VALID_PASS. Failed/invalid/aborted Runs remain evidence.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "Prometheus"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "count(domibus_poc_run_info{run_result!=\"VALID_PASS\"})",
                        "instant": true,
                        "legendFormat": "__auto",
                        "range": false
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "13.2.0",
            "spec": {
              "options": {
                "reduceOptions": {
                  "values": false,
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": ""
                },
                "orientation": "auto",
                "textMode": "auto",
                "wideLayout": true,
                "colorMode": "value",
                "graphMode": "none",
                "justifyMode": "auto",
                "showPercentChange": false,
                "percentChangeColorMode": "standard"
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "none",
                  "color": {
                    "mode": "thresholds"
                  },
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "color": "green",
                        "value": 0
                      },
                      {
                        "color": "red",
                        "value": 1
                      }
                    ]
                  },
                  "noValue": "—"
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-largest-payload": {
        "kind": "Panel",
        "spec": {
          "id": 5,
          "title": "Largest Verified Payload",
          "description": "Largest payload from a VALID_PASS Run with integrity result PASS.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "Prometheus"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "max(domibus_poc_run_payload_size_bytes and on(run_id) domibus_poc_run_info{run_result=\"VALID_PASS\",integrity_result=\"PASS\"})",
                        "instant": true,
                        "legendFormat": "__auto",
                        "range": false
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "13.2.0",
            "spec": {
              "options": {
                "reduceOptions": {
                  "values": false,
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": ""
                },
                "orientation": "auto",
                "textMode": "auto",
                "wideLayout": true,
                "colorMode": "value",
                "graphMode": "none",
                "justifyMode": "auto",
                "showPercentChange": false,
                "percentChangeColorMode": "standard"
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "bytes",
                  "color": {
                    "mode": "thresholds"
                  },
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "color": "green",
                        "value": 0
                      }
                    ]
                  },
                  "noValue": "—"
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-latest-success": {
        "kind": "Panel",
        "spec": {
          "id": 6,
          "title": "Latest Successful Run",
          "description": "Run ID of the most recently completed successful, integrity-verified Run.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "Prometheus"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "topk(1, domibus_poc_run_completed_timestamp_seconds * on(run_id) group_left() domibus_poc_run_info{run_result=\"VALID_PASS\",integrity_result=\"PASS\"})",
                        "instant": true,
                        "legendFormat": "{{run_id}}",
                        "range": false
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "13.2.0",
            "spec": {
              "options": {
                "reduceOptions": {
                  "values": false,
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": ""
                },
                "orientation": "auto",
                "textMode": "name",
                "wideLayout": true,
                "colorMode": "value",
                "graphMode": "none",
                "justifyMode": "auto",
                "showPercentChange": false,
                "percentChangeColorMode": "standard"
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "color": {
                    "mode": "thresholds"
                  },
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "color": "green",
                        "value": 0
                      }
                    ]
                  },
                  "noValue": "—"
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-recent-runs": {
        "kind": "Panel",
        "spec": {
          "id": 7,
          "title": "Recent Runs — click Run ID for Dashboard 01",
          "description": "Latest 20 Runs after applying dashboard filters. T8−T0 is the primary delivery duration.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "Prometheus"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "topk(20, 1000 * domibus_poc_run_completed_timestamp_seconds * on(run_id) group_left(phase,experiment_id,direction,configuration_id,run_result,integrity_result,failure_category,payload_id,payload_class) domibus_poc_run_info{phase=~\"$phase\",experiment_id=~\"$experiment\",direction=~\"$direction\",configuration_id=~\"$configuration\",run_result=~\"$run_result\"})",
                        "instant": true,
                        "legendFormat": "__auto",
                        "range": false,
                        "format": "table"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "Prometheus"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "domibus_poc_run_payload_size_bytes and on(run_id) topk(20, domibus_poc_run_completed_timestamp_seconds * on(run_id) group_left(phase,experiment_id,direction,configuration_id,run_result,integrity_result,failure_category,payload_id,payload_class) domibus_poc_run_info{phase=~\"$phase\",experiment_id=~\"$experiment\",direction=~\"$direction\",configuration_id=~\"$configuration\",run_result=~\"$run_result\"})",
                        "instant": true,
                        "legendFormat": "__auto",
                        "range": false,
                        "format": "table"
                      }
                    },
                    "refId": "B",
                    "hidden": false
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "Prometheus"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "domibus_poc_run_delivery_duration_seconds and on(run_id) topk(20, domibus_poc_run_completed_timestamp_seconds * on(run_id) group_left(phase,experiment_id,direction,configuration_id,run_result,integrity_result,failure_category,payload_id,payload_class) domibus_poc_run_info{phase=~\"$phase\",experiment_id=~\"$experiment\",direction=~\"$direction\",configuration_id=~\"$configuration\",run_result=~\"$run_result\"})",
                        "instant": true,
                        "legendFormat": "__auto",
                        "range": false,
                        "format": "table"
                      }
                    },
                    "refId": "C",
                    "hidden": false
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "Prometheus"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "domibus_poc_run_throughput_bytes_per_second and on(run_id) topk(20, domibus_poc_run_completed_timestamp_seconds * on(run_id) group_left(phase,experiment_id,direction,configuration_id,run_result,integrity_result,failure_category,payload_id,payload_class) domibus_poc_run_info{phase=~\"$phase\",experiment_id=~\"$experiment\",direction=~\"$direction\",configuration_id=~\"$configuration\",run_result=~\"$run_result\"})",
                        "instant": true,
                        "legendFormat": "__auto",
                        "range": false,
                        "format": "table"
                      }
                    },
                    "refId": "D",
                    "hidden": false
                  }
                }
              ],
              "transformations": [
                {
                  "kind": "Transformation",
                  "group": "joinByField",
                  "spec": {
                    "options": {
                      "byField": "run_id",
                      "mode": "outer"
                    }
                  }
                },
                {
                  "kind": "Transformation",
                  "group": "organize",
                  "spec": {
                    "options": {
                      "excludeByName": {
                        "Time": true,
                        "Time 1": true,
                        "Time 2": true,
                        "Time 3": true,
                        "__name__": true,
                        "__name__ 1": true,
                        "__name__ 2": true,
                        "__name__ 3": true,
                        "job": true,
                        "instance": true
                      },
                      "indexByName": {
                        "run_id": 0,
                        "experiment_id": 1,
                        "phase": 2,
                        "direction": 3,
                        "payload_id": 4,
                        "payload_class": 5,
                        "configuration_id": 6,
                        "Value #A": 7,
                        "Value #B": 8,
                        "Value #C": 9,
                        "Value #D": 10,
                        "integrity_result": 11,
                        "run_result": 12,
                        "failure_category": 13
                      },
                      "renameByName": {
                        "run_id": "Run ID",
                        "experiment_id": "Experiment",
                        "phase": "Phase",
                        "direction": "Direction",
                        "payload_id": "Payload ID",
                        "payload_class": "Payload class",
                        "configuration_id": "Configuration",
                        "Value #A": "Completed",
                        "Value #B": "Payload Size",
                        "Value #C": "Delivery Duration",
                        "Value #D": "Throughput",
                        "integrity_result": "Integrity",
                        "run_result": "Result",
                        "failure_category": "Failure category"
                      }
                    }
                  }
                }
              ],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "table",
            "version": "13.2.0",
            "spec": {
              "options": {
                "cellHeight": "sm",
                "showHeader": true,
                "sortBy": [
                  {
                    "desc": true,
                    "displayName": "Completed"
                  }
                ]
              },
              "fieldConfig": {
                "defaults": {
                  "custom": {
                    "align": "auto",
                    "cellOptions": {
                      "type": "auto"
                    },
                    "inspect": false
                  }
                },
                "overrides": [
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Run ID"
                    },
                    "properties": [
                      {
                        "id": "custom.width",
                        "value": 260
                      },
                      {
                        "id": "links",
                        "value": [
                          {
                            "title": "Open Run Analysis",
                            "url": "/d/domibus-run-analysis/domibus-run-analysis?var-run_id=${__value.raw}"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Completed"
                    },
                    "properties": [
                      {
                        "id": "unit",
                        "value": "dateTimeAsIso"
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Payload Size"
                    },
                    "properties": [
                      {
                        "id": "unit",
                        "value": "bytes"
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Delivery Duration"
                    },
                    "properties": [
                      {
                        "id": "unit",
                        "value": "s"
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Throughput"
                    },
                    "properties": [
                      {
                        "id": "unit",
                        "value": "Bps"
                      }
                    ]
                  }
                ]
              }
            }
          }
        }
      },
      "panel-champions": {
        "kind": "Panel",
        "spec": {
          "id": 8,
          "title": "Current Champions",
          "description": "Current PERF, EFF, REAL and MAX champion configurations.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "Prometheus"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "domibus_poc_champion_info",
                        "instant": true,
                        "legendFormat": "__auto",
                        "range": false,
                        "format": "table"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [
                {
                  "kind": "Transformation",
                  "group": "organize",
                  "spec": {
                    "options": {
                      "excludeByName": {
                        "Time": true,
                        "Value": true,
                        "__name__": true,
                        "job": true,
                        "instance": true
                      },
                      "indexByName": {
                        "category": 0,
                        "configuration_id": 1,
                        "phase": 2,
                        "reason_code": 3
                      },
                      "renameByName": {
                        "category": "Champion",
                        "configuration_id": "Configuration",
                        "phase": "Phase",
                        "reason_code": "Reason"
                      }
                    }
                  }
                }
              ],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "table",
            "version": "13.2.0",
            "spec": {
              "options": {
                "cellHeight": "sm",
                "showHeader": true
              },
              "fieldConfig": {
                "defaults": {
                  "custom": {
                    "align": "auto",
                    "cellOptions": {
                      "type": "auto"
                    }
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-run-outcomes": {
        "kind": "Panel",
        "spec": {
          "id": 9,
          "title": "Run Outcomes",
          "description": "Run-result distribution for the current dashboard filters.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "Prometheus"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "count by (run_result) (domibus_poc_run_info{phase=~\"$phase\",experiment_id=~\"$experiment\",direction=~\"$direction\",configuration_id=~\"$configuration\",run_result=~\"$run_result\"})",
                        "instant": true,
                        "legendFormat": "{{run_result}}",
                        "range": false
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "bargauge",
            "version": "13.2.0",
            "spec": {
              "options": {
                "displayMode": "gradient",
                "legend": {
                  "calcs": [],
                  "displayMode": "list",
                  "placement": "bottom",
                  "showLegend": false
                },
                "maxVizHeight": 300,
                "minVizHeight": 16,
                "minVizWidth": 8,
                "namePlacement": "auto",
                "orientation": "horizontal",
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": false
                },
                "showUnfilled": true,
